# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Login options to show: email, phone, google, apple (comma separated).
# Only list what is enabled in Supabase › Authentication › Sign In / Providers.
# Phone needs an SMS provider (e.g. Twilio); Google/Apple need OAuth keys.
NEXT_PUBLIC_AUTH_METHODS=email

# Phase 1 "Biometric Mock": when true, FaceID / fingerprint unlock is simulated
# (always succeeds) instead of using the device authenticator via WebAuthn.
NEXT_PUBLIC_BIOMETRIC_MOCK=false
