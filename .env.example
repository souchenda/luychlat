# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Login options to show (comma separated): email (password), email_code (one-time
# code by email; needs custom SMTP in Supabase), phone, google, apple.
# Only list what is enabled in Supabase › Authentication › Sign In / Providers.
# Phone needs an SMS provider (e.g. Twilio); Google/Apple need OAuth keys.
NEXT_PUBLIC_AUTH_METHODS=email

# Phase 1 "Biometric Mock": when true, FaceID / fingerprint unlock is simulated
# (always succeeds) instead of using the device authenticator via WebAuthn.
NEXT_PUBLIC_BIOMETRIC_MOCK=false

# SERVER-ONLY secret (no NEXT_PUBLIC_ prefix, never sent to the browser):
# Anthropic key for LuySmart AI, the PRO advisor (quota per user is enforced in
# the database). On the Droplet put it in .env next to docker-compose.yml.
# Free users can still use their own key from Settings.
ANTHROPIC_API_KEY=

# --- KHQR checkout (Step B) — SERVER-ONLY secrets, never NEXT_PUBLIC_ -------
# off | sandbox | production. Sandbox: no Bakong calls; admins can simulate a
# payment to test the whole flow. Production needs the Bakong token below.
KHQR_MODE=off
KHQR_EXPIRY_MINUTES=15
# The Bakong account that receives the money, e.g. yourname@aclb
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=LuySmart
BAKONG_MERCHANT_CITY=Phnom Penh
# Only for a merchant (business) account; leave empty for an individual account.
BAKONG_MERCHANT_ID=
BAKONG_ACQUIRING_BANK=
# Bakong Open API token (expires; renew it before then).
BAKONG_API_TOKEN=
# Bakong may only accept calls from Cambodian IPs; a relay URL can go here.
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
# Supabase › Project Settings › API Keys › Secret key (sb_secret_...). Confirms
# KHQR payments and extends PRO. Server-only: no NEXT_PUBLIC_ prefix, ever.
SUPABASE_SECRET_KEY=
