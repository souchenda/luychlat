# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Login options to show (comma separated): email (password), email_code (one-time
# code by email; needs custom SMTP in Supabase), phone, google, apple.
# Only list what is enabled in Supabase › Authentication › Sign In / Providers.
# Phone needs an SMS provider (e.g. Twilio); Google/Apple need OAuth keys.
NEXT_PUBLIC_AUTH_METHODS=email

# Phase 1 "Biometric Mock": when true, FaceID / fingerprint unlock is simulated
# (always succeeds) instead of using the device authenticator via WebAuthn.
NEXT_PUBLIC_BIOMETRIC_MOCK=false

# SERVER-ONLY secret (no NEXT_PUBLIC_ prefix, never sent to the browser):
# Anthropic key for LuySmart AI, the PRO advisor (quota per user is enforced in
# the database). On the Droplet put it in .env next to docker-compose.yml.
# Free users can still use their own key from Settings.
ANTHROPIC_API_KEY=
