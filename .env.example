# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Login options to show (comma separated): email (password), email_code (one-time
# code by email; needs custom SMTP in Supabase), phone, google, apple.
# Only list what is enabled in Supabase › Authentication › Sign In / Providers.
# Phone needs an SMS provider (e.g. Twilio); Google/Apple need OAuth keys.
NEXT_PUBLIC_AUTH_METHODS=email

# Phase 1 "Biometric Mock": when true, FaceID / fingerprint unlock is simulated
# (always succeeds) instead of using the device authenticator via WebAuthn.
NEXT_PUBLIC_BIOMETRIC_MOCK=false

# SERVER-ONLY secret (no NEXT_PUBLIC_ prefix, never sent to the browser):
# Anthropic key for LuyChlat AI, the PRO advisor (quota per user is enforced in
# the database). On the Droplet put it in .env next to docker-compose.yml.
# Free users can still use their own key from Settings.
ANTHROPIC_API_KEY=

# SERVER-ONLY secret: the official Telegram bot (@LuyChlat_bot) from @BotFather.
# On the Droplet put it in .env next to docker-compose.yml, then press
# "Activate bot" in /admin once. Reminders are sent only by the production server.
TELEGRAM_BOT_TOKEN=

# SERVER-ONLY secret, optional: speech-to-text for voice notes sent to the bot
# (PRO "Log by chat"). Set ONE of them; Groq (whisper-large-v3) is used first.
# Leave both empty and the bot asks users to type instead.
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional: @luychlat_bot posts a market bulletin (NBC rates, gold, tip of the
# day) every morning at 08:00 Cambodia time to this channel or group, e.g.
# @luychlat_community or -1001234567890. Add the bot as an admin of the
# channel first. Leave empty to turn it off.
TELEGRAM_COMMUNITY_CHAT_ID=
