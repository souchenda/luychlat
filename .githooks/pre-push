#!/bin/sh
# Pre-push gate (Regression Prevention Protocol): before anything reaches master — the server builds and deploys every
# push — only the tests that cover what this push changes (founder, 5/11/2026 — mandatory: «test only the part that was
# changed, wherever»; scripts/affected-tests.mjs, golden ones included), the website gate when the website changed, and
# the typecheck. Bypass only with the founder's OK.
git diff --name-only origin/master HEAD > /tmp/luychlat-changed.txt 2>/dev/null || echo ALL > /tmp/luychlat-changed.txt
tests=$(node scripts/affected-tests.mjs /tmp/luychlat-changed.txt)
if [ "$tests" = "ALL" ]; then
  echo "→ Golden paths (npm run test:golden)…"
  npm run --silent test:golden >/tmp/luychlat-golden.log 2>&1 || { tail -40 /tmp/luychlat-golden.log; echo "✗ Golden path broken — push aborted."; exit 1; }
elif [ -n "$tests" ]; then
  echo "→ Tests of what changed ($(echo "$tests" | wc -l))…"
  # shellcheck disable=SC2086
  npx tsx --test --test-force-exit $tests >/tmp/luychlat-golden.log 2>&1 || { tail -40 /tmp/luychlat-golden.log; echo "✗ A test of this change fails — push aborted."; exit 1; }
fi
if grep -qE '^(Website/|scripts/website-)' /tmp/luychlat-changed.txt; then
  echo "→ Website quality gate (scripts/website-check.mjs)…"
  node scripts/website-check.mjs >/tmp/luychlat-website.log 2>&1 || { tail -30 /tmp/luychlat-website.log; echo "✗ The website has errors — push aborted (a release publishes it on its own)."; exit 1; }
fi
echo "→ Typecheck…"
npx tsc --noEmit -p . || { echo "✗ Typecheck failed — push aborted."; exit 1; }
echo "✓ The tests of this change and the typecheck pass."
